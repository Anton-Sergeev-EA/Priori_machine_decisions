REGISTRY=ghcr.io
OWNER=your-github-username

DEFAULT_PACKAGE_REPO=https://github.com/hku-mars/FAST_LIO.git
DEFAULT_BRANCH=main
DEFAULT_CUDA_ARCH=87

# Для нативной сборки на Jetson (self-hosted runner).
# Установите эти переменные на устройстве.
JETSON_AGX_IP=192.168.1.100
JETSON_NANO_IP=192.168.1.101

# Токен для GitHub Packages.
# Создайте Personal Access Token с правами write:packages.
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
